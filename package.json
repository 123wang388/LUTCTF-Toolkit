{
  "name": "lutctf-toolkit",
  "version": "2.1.0",
  "description": "奇点战队 CTF 工具合集 - 为海丰杯而生",
  "main": "main.js",
  "author": "奇点战队（Singularity）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/123wang388/LUTCTF-Toolkit.git"
  },
  "homepage": "https://github.com/123wang388/LUTCTF-Toolkit",
  "bugs": {
    "url": "https://github.com/123wang388/LUTCTF-Toolkit/issues"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.qidian.ctf.toolkit",
    "productName": "奇点 CTF 工具合集",
    "copyright": "奇点战队（Singularity）",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Qidian-CTF-Toolkit-${version}-portable.${ext}"
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
